\newcommand{\projecttitle}[1]{\def\theprojecttitle{#1}}
\newcommand{\projectcourse}[1]{\def\theprojectcourse{#1}}
\newcommand{\projectauthor}[1]{\def\theprojectauthor{#1}}
\newcommand{\projectid}[1]{\def\theprojectid{#1}}
\newcommand{\projectschool}[1]{\def\theprojectschool{#1}}
\newcommand{\projectteacher}[1]{\def\theprojectteacher{#1}}
\newcommand{\projectdate}[1]{\def\theprojectdate{#1}}

\pagestyle{fancy}
\fancyhf{}
\lhead{\theprojectcourse}
\rhead{\theprojectauthor\quad\theprojectid}
\cfoot{\thepage}

\newcommand{\makeprojectcover}{
  \begin{titlepage}
    \vspace*{-2cm}
    \begin{figure}[h]
      \centering
      \includegraphics[width=0.65\linewidth]{figures/char.png}
    \end{figure}
    \begin{figure}[h]
      \centering
      \includegraphics[width=0.45\linewidth]{figures/logo.png}
    \end{figure}
    \vspace{0.5cm}
    \begin{center}
      {\Huge\bfseries 项目设计报告\\[0.4cm]}
      {\Large\bfseries\resizebox{0.96\linewidth}{!}{\theprojecttitle}}
    \end{center}
    \vspace{1.2cm}
    \begin{center}
      \Large
      课程名称\ \underline{\makebox[220pt]{\theprojectcourse}}\\[0.35cm]
      姓\qquad 名\ \underline{\makebox[220pt]{\theprojectauthor}}\\[0.35cm]
      学\qquad 号\ \underline{\makebox[220pt]{\theprojectid}}\\[0.35cm]
      学\qquad 院\ \underline{\makebox[220pt]{\theprojectschool}}\\[0.35cm]
      指导教师\ \underline{\makebox[220pt]{\theprojectteacher}}\\[0.35cm]
      完成日期\ \underline{\makebox[220pt]{\theprojectdate}}
    \end{center}
  \end{titlepage}
}

